# Configure a trusted HTTPS endpoint that persists enquiries or sends email.
# It must verify the HMAC SHA-256 signature and acknowledge only after receipt.
ENQUIRY_WEBHOOK_URL=
ENQUIRY_WEBHOOK_SECRET=
# Required privacy details before accepting personal information.
LEGAL_ENTITY=
PRIVACY_EMAIL=
ENQUIRY_RETENTION=
# Optional public contact details. Supply confirmed Do Clubs details only.
NEXT_PUBLIC_CONTACT_EMAIL=
NEXT_PUBLIC_CONTACT_PHONE=

# Optional external booking destination. HTTPS only; defaults to /clubs.
NEXT_PUBLIC_BOOKING_URL=
